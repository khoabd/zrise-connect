venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local state (should not be shared)
state/local/
state/zrise/work-items/*.json
!state/zrise/work-items/.gitkeep

# Test cache
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/

# Node (if any)
node_modules/
npm-debug.log
yarn-error.log

# Local secrets (OpenClaw config reference only - actual config in ~/.openclaw/)
# Do NOT commit actual tokens/keys

