{
  "name": "zrise-connect",
  "version": "3.4.0",
  "description": "Zrise integration skill - Automate tasks with AI workflows via XML-RPC",
  "author": "AI Strategy",
  "license": "MIT",
  "repository": "https://github.com/openclaw/zrise-connect",
  "keywords": [
    "zrise",
    "automation",
    "ai",
    "workflow",
    "task-management",
    "xml-rpc",
    "lobster"
  ],
  "scripts": [
    "scripts/zrise_utils.py",
    "scripts/fetch_task_data.py",
    "scripts/analyze_task.py",
    "scripts/execute_ai_task.py",
    "scripts/writeback_to_zrise.py",
    "scripts/update_task_stage.py",
    "scripts/fill_timesheet.py",
    "scripts/poll_employee_work.py",
    "scripts/zrise-poll-cron.sh",
    "scripts/zrise_task_info.py"
  ],
  "workflows": {
    "zrise-execute": {
      "file": "workflows/zrise-execute.lobster",
      "description": "Full 8-step flow: fetch → analyze → plan → execute → review → writeback → timesheet → done",
      "category": "automation",
      "recommended": true
    },
    "zrise-poll": {
      "file": "workflows/zrise-poll.lobster",
      "description": "Poll tasks for employee and send notifications",
      "category": "polling"
    },
    "simple": {
      "file": "workflows/simple.lobster",
      "description": "Simple execution - Single agent call",
      "category": "general"
    },
    "email-draft": {
      "file": "workflows/email-draft.lobster",
      "description": "Draft email notifications",
      "category": "communication"
    },
    "requirement-analysis": {
      "file": "workflows/requirement-analysis.lobster",
      "description": "Analyze requirements, create user stories",
      "category": "analysis"
    }
  },
  "env": {
    "ZRISE_URL": "https://zrise.app",
    "ZRISE_DB": "zrise",
    "ZRISE_USERNAME": "khoa.bd@atomsolution.com.vn",
    "ZRISE_API_KEY": ""
  },
  "config": {
    "agent_id": "ai-company",
    "channel": "telegram",
    "reply_account": "zrise"
  },
  "capabilities": [
    "workflow_management",
    "task_automation",
    "ai_processing",
    "zrise_integration",
    "xml_rpc_api",
    "html_comments",
    "timesheet_tracking",
    "stage_management",
    "cron_polling"
  ],
  "agent_routing": {
    "requirement-analysis": "demo-ba",
    "email-draft": "ai-company",
    "technical-design": "demo-architect",
    "development": "demo-be",
    "testing": "demo-qc",
    "general": "ai-company"
  },
  "state_paths": {
    "poll_state": "state/zrise/poll-state",
    "sessions": "state/zrise/sessions",
    "tasks": ".tasks"
  },
  "docs": [
    "README.md",
    "SKILL.md",
    "docs/WORKFLOW_TEMPLATES.md",
    "docs/TELEGRAM_INTEGRATION.md",
    "docs/TEAM_ONBOARDING.md",
    "docs/AGENT_ROUTING.md"
  ],
  "dependencies": {
    "python": ">=3.8",
    "openclaw": ">=2026.3.0",
    "lobster": ">=2026.1.0"
  },
  "ssl_fix": {
    "applied": true,
    "reason": "macOS Python 3.11 SSL certificate verification",
    "method": "ssl._create_unverified_context()"
  }
}
